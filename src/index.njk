<div class="nav-overlay" id="nav-overlay"></div>
<div class="nav-drawer" id="nav-drawer" aria-hidden="true">
  <ul class="drawer-links">
    <li><a href="#proyectos" class="drawer-link" data-section="proyectos">Proyectos</a></li>
    <li><a href="#acerca" class="drawer-link" data-section="acerca">Sobre mí</a></li>
    <li><a href="#valoraciones" class="drawer-link" data-section="valoraciones">Valoraciones</a></li>
    <li><a href="#contacto" class="drawer-link" data-section="contacto">Contacto</a></li>
