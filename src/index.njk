          </div>
        </div>
      </div>
    </div>
  </section>

  <div id="stats">
    <div class="container" style="padding:0">
      <div class="stats-inner">
        <div class="stat-item"><div class="stat-num">{{ general.stat1_num | safe }}</div><div class="stat-lbl">{{ general.stat1_label }}</div></div>
        <div class="stat-item"><div class="stat-num">{{ general.stat2_num | safe }}</div><div class="stat-lbl">{{ general.stat2_label }}</div></div>
        <div class="stat-item"><div class="stat-num">{{ general.stat3_num }}</div><div class="stat-lbl">{{ general.stat3_label }}</div></div>
        <div class="stat-item"><div class="stat-num">{{ general.stat4_num | safe }}</div><div class="stat-lbl">{{ general.stat4_label }}</div></div>
      </div>
    </div>
  </div>

  <section id="proyectos">
    <div class="container">
      <div class="projects-header reveal">
        <div class="section-label">Proyectos</div>
        <h2 class="section-h2">Negocios que dejaron<br>el papel atrás.</h2>
        <p class="section-sub">Cada proyecto arranca de un problema concreto. Identificamos la necesidad, y proponemos una solución personalizada.</p>
      </div>
      <div class="projects-grid" id="projects-grid">
        {%- set proyectosDestacados = [] -%}
        {%- for key, p in proyectos -%}
          {%- if p.destacado -%}
            {%- set proyectosDestacados = (proyectosDestacados.push(p), proyectosDestacados) -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for p in proyectosDestacados | sort(attribute="orden") -%}
        <div class="project-card reveal" onclick="openProject({{ loop.index0 }})">
          <div class="card-img">
            {%- if p.mockup %}
            <img src="{{ p.mockup }}" alt="Sistema de gestión {{ p.titulo }} — deciDATA" class="mockup-img">
            {%- else %}
            <div class="card-img-placeholder">
              <div class="ci-header">
                {%- if p.logo %}<img src="{{ p.logo }}" alt="{{ p.titulo }}" style="height:20px;width:auto;object-fit:contain;">{%- else %}<span class="ci-title">{{ p.titulo }}</span>{%- endif %}
                <span class="ci-badge">Sistema</span>
              </div>
              <div class="ci-kpis">
                {%- for chip in p.chips | slice(3) %}<div class="ci-kpi"><div class="ci-klbl">{{ chip }}</div><div class="ci-kval" style="color:var(--accent)">✓</div></div>{%- endfor %}
              </div>
              <div class="ci-bars">
                <div class="ci-bar" style="height:40%"></div><div class="ci-bar" style="height:55%"></div><div class="ci-bar" style="height:48%"></div><div class="ci-bar" style="height:62%"></div><div class="ci-bar" style="height:58%"></div><div class="ci-bar" style="height:85%;background:var(--accent)"></div>
              </div>
            </div>
            {%- endif %}
            {%- if p.logo and not p.mockup %}<img src="{{ p.logo }}" alt="{{ p.titulo }}" class="card-client-logo">{%- endif %}
          </div>
          <div class="card-body">
            <div class="card-tag">{{ p.tag }}</div>
            <div class="card-title">{{ p.titulo }}</div>
            <div class="card-desc">{{ p.descripcion }}</div>
            <div class="card-kpis">
              {%- for chip in p.chips %}<span class="card-kpi-chip">{{ chip }}</span>{%- endfor %}
            </div>
            <div class="card-link">Ver proyecto <span class="arr">→</span></div>
          </div>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section id="valoraciones">
    <div class="container">
      <div class="test-header reveal">
        <div class="section-label">Valoraciones</div>
        <h2 class="section-h2">Lo que dicen<br>los clientes.</h2>
      </div>
    </div>
    <div class="test-track">
      <div class="test-inner">
        {%- set resenas = [] -%}
        {%- for key, p in proyectos -%}
          {%- if p.resena_texto -%}
            {%- set resenas = (resenas.push(p), resenas) -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for p in resenas %}<div class="test-card"><div class="test-quote-mark">"</div><p class="test-text">{{ p.resena_texto }}</p><div class="test-author"><div class="test-avatar">{{ p.resena_nombre | truncate(2, true, "") | upper }}</div><div><div class="test-name">{{ p.resena_nombre }}</div><div class="test-role">{{ p.resena_rol }}</div></div></div></div>{%- endfor %}
        {%- for p in resenas %}<div class="test-card"><div class="test-quote-mark">"</div><p class="test-text">{{ p.resena_texto }}</p><div class="test-author"><div class="test-avatar">{{ p.resena_nombre | truncate(2, true, "") | upper }}</div><div><div class="test-name">{{ p.resena_nombre }}</div><div class="test-role">{{ p.resena_rol }}</div></div></div></div>{%- endfor %}
      </div>
    </div>
  </section>

  <section id="acerca">
    <div class="container">
      <div class="about-grid">
        <div class="reveal">
          <div class="section-label">{{ general.acerca_label }}</div>
          <h2 class="about-h2">{{ general.acerca_h2_p1 }}<br>{{ general.acerca_h2_p2 }}<br><em>{{ general.acerca_h2_em }}</em></h2>
          <p class="about-p">{{ general.bio1 }}</p>
          <p class="about-p">{{ general.bio2 }}</p>
        </div>
        <div class="reveal">
          <div class="about-card">
            <div class="about-card-top">
              <div class="about-avatar">
                {%- if general.foto_perfil %}
                <img src="{{ general.foto_perfil }}" alt="{{ general.nombre }}, {{ general.rol }} — deciDATA" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;display:block;">
                {%- else %}JT{%- endif %}
              </div>
              <div>
                <div class="about-name">{{ general.nombre }}</div>
                <div class="about-role">{{ general.rol }}</div>
              </div>
            </div>
            <div class="about-card-body">
              <p class="about-card-text">{{ general.card_bio1 }}</p>
              <p class="about-card-text">{{ general.card_bio2 }}</p>
              <div class="about-tags">
                {%- for tag in general.about_tags %}<span class="about-tag">{{ tag }}</span>{%- endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="contacto">
    <div class="container">
      <div class="cta-box reveal">
        <h2 class="cta-h2">{{ general.cta_titulo }}</h2>
        <p class="cta-sub">{{ general.cta_sub }}</p>
        <div class="cta-actions">
          <a href="https://wa.me/{{ general.whatsapp }}" target="_blank" class="btn-whatsapp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Escribir por WhatsApp
          </a>
          <a href="/proyectos" class="btn-light">Ver proyectos →</a>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <div class="nav-logo">
      <img src="/images/decidata_negro_png.png" alt="deciDATA" style="height:24px;width:auto;display:block;">
    </div>
    <span class="footer-text">WhatsApp: {{ general.whatsapp_display }}</span>
    <span class="footer-text">{{ general.footer_copy }}</span>
  </footer>

</div>

<div id="project-detail">
  <div class="container">
    <button class="detail-back" onclick="showHome()">← Volver a proyectos</button>
    <div id="detail-content"></div>
  </div>
</div>

<script>
const PROYECTOS = {{ proyectos | dump | safe }};

function openProject(idx) {
  const keys = Object.keys(PROYECTOS);
  const destacados = keys.map(k => PROYECTOS[k]).filter(p => p.destacado).sort((a,b) => (a.orden||99)-(b.orden||99));
  const p = destacados[idx];
  if (!p) return;

  const logoHTML = p.logo ? `<img src="${p.logo}" alt="Logo ${p.titulo}" class="detail-logo">` : '';
  const mockupHTML = p.mockup ? `<img src="${p.mockup}" alt="Sistema de gestión ${p.titulo} — deciDATA" class="detail-mockup">` : '';
  const featuresHTML = (p.funcionalidades||[]).map(f => `<div class="feature-chip"><div class="feature-dot"></div>${f}</div>`).join('');
  const resultsHTML = (p.resultados||[]).map(r => `<div class="result-card"><div class="result-text">${r}</div></div>`).join('');

  document.getElementById('detail-content').innerHTML = `
    <div class="detail-header">
      ${logoHTML}
      <div class="detail-tag">${p.tag}</div>
      <h1 class="detail-title">${p.titulo}</h1>
      <p class="detail-desc">${p.descripcion}</p>
    </div>
    ${mockupHTML}
    <div class="detail-quote"><p>"${p.quote}"</p><cite>— ${p.quoteAutor}</cite></div>
    <div class="detail-section-title">El problema</div>
    <p class="detail-problem">${p.problema}</p>
    <div class="detail-section-title">Funcionalidades</div>
    <div class="features-grid">${featuresHTML}</div>
    <div class="detail-section-title">Resultados</div>
    <div class="results-grid">${resultsHTML}</div>
    <div class="detail-section-title">Solución</div>
    <div class="solution-tag">→ ${p.solucion}</div>
  `;

  document.getElementById('main-content').style.display = 'none';
  document.getElementById('project-detail').classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
}

function showHome() {
  document.getElementById('project-detail').classList.remove('active');
  document.getElementById('main-content').style.display = '';
  setTimeout(() => document.getElementById('proyectos').scrollIntoView({behavior:'smooth',block:'start'}), 60);
}

// Scroll → nav materialise
window.addEventListener('scroll', () => {
  document.getElementById('nav').classList.toggle('scrolled', window.scrollY > 50);
}, { passive: true });

// Active nav link via IntersectionObserver
const navSectionObs = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    const link = document.querySelector(`.nav-link[data-section="${entry.target.id}"]`);
    if (!link) return;
    if (entry.isIntersecting) {
      document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
      link.classList.add('active');
    }
  });
}, { rootMargin: '-20% 0px -70% 0px' });
['proyectos','acerca','valoraciones','contacto'].forEach(id => {
  const el = document.getElementById(id);
  if (el) navSectionObs.observe(el);
});

// Hamburger drawer
const hamburger = document.getElementById('hamburger');
const drawer    = document.getElementById('nav-drawer');
const overlay   = document.getElementById('nav-overlay');

function openDrawer() {
  hamburger.setAttribute('aria-expanded', 'true');
  hamburger.classList.add('open');
  drawer.classList.add('open');
  overlay.classList.add('open');
  drawer.setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
}
function closeDrawer() {
  hamburger.setAttribute('aria-expanded', 'false');
  hamburger.classList.remove('open');
  drawer.classList.remove('open');
  overlay.classList.remove('open');
  drawer.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
}
hamburger.addEventListener('click', () => {
  hamburger.getAttribute('aria-expanded') === 'true' ? closeDrawer() : openDrawer();
});
overlay.addEventListener('click', closeDrawer);
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });

// Smooth scroll — nav links + drawer links
function handleAnchorClick(e) {
  const href = this.getAttribute('href');
  if (!href.startsWith('#')) return;
  e.preventDefault();
  closeDrawer();
  const id = href.slice(1);
  if (document.getElementById('project-detail').classList.contains('active')) {
    document.getElementById('project-detail').classList.remove('active');
    document.getElementById('main-content').style.display = '';
  }
  setTimeout(() => {
    const el = document.getElementById(id);
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }, 60);
}
document.querySelectorAll('.nav-link, .drawer-link').forEach(a => {
  a.addEventListener('click', handleAnchorClick);
});

const obs = new IntersectionObserver(entries => {
  entries.forEach((e,i) => { if(e.isIntersecting){setTimeout(()=>e.target.classList.add('visible'),i*60);obs.unobserve(e.target);}});
},{threshold:.08});
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
</script>

<a href="https://wa.me/{{ general.whatsapp }}" target="_blank" class="fab-wa" aria-label="Hablemos por WhatsApp">
  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
</a>
</body>
</html>