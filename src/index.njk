            <div class="bi-phone">
              <div class="bi-phone-notch"></div>
              <div class="bi-phone-screen">
                <div class="bi-ph-label">Estado alumnas</div>
                <div class="bi-ph-row">
                  <span class="bi-ph-name">M. García</span>
                  <span class="bi-ph-tag bi-tag-ok">Pagó</span>
                </div>
                <div class="bi-ph-row">
                  <span class="bi-ph-name">S. Rodríguez</span>
                  <span class="bi-ph-tag bi-tag-ok">Pagó</span>
                </div>
                <div class="bi-ph-row">
                  <span class="bi-ph-name">L. Castro</span>
                  <span class="bi-ph-tag bi-tag-no">Debe</span>
                </div>
                <div class="bi-ph-row">
                  <span class="bi-ph-name">C. Méndez</span>
                  <span class="bi-ph-tag bi-tag-ok">Pagó</span>
                </div>
                <div class="bi-ph-row" style="border:none">
                  <span class="bi-ph-name">A. Fernández</span>
                  <span class="bi-ph-tag bi-tag-no">Debe</span>
