            <div class="prop-row"><span class="prop-arrow">→</span><span class="prop-text"><strong>{{ general.prop2_negrita }}</strong> <span>→ {{ general.prop2_texto }}</span></span></div>
            <div class="prop-row"><span class="prop-arrow">→</span><span class="prop-text"><strong>{{ general.prop3_negrita }}</strong> <span>→ {{ general.prop3_texto }}</span></span></div>
            <div class="prop-row"><span class="prop-arrow">→</span><span class="prop-text"><strong>{{ general.prop4_negrita }}</strong> <span>→ {{ general.prop4_texto }}</span></span></div>
          </div>
          <div class="hero-actions">
            <a href="https://wa.me/{{ general.whatsapp }}" target="_blank" class="btn-whatsapp">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              Hablemos por WhatsApp
            </a>
            <a href="#proyectos" class="btn-light nav-anchor">Ver proyectos →</a>
          </div>
        </div>
        <div class="hero-right">
          <div class="hero-bi-scene">

            <div class="bi-sidebar">
              <div class="bi-kpi-card bi-kpi-teal">
                <div class="bi-kpi-label">Ingresos</div>
                <div class="bi-kpi-value">$284k</div>
                <div class="bi-kpi-sub">↑ 12% vs mes anterior</div>
              </div>
              <div class="bi-kpi-card bi-kpi-amber">
                <div class="bi-kpi-label">Egresos</div>
                <div class="bi-kpi-value">$148k</div>
                <div class="bi-kpi-sub">↓ 3% vs mes anterior</div>
              </div>
              <div class="bi-kpi-card bi-kpi-slate">
                <div class="bi-kpi-label">Ganancia</div>
                <div class="bi-kpi-value">$135k</div>
                <div class="bi-kpi-sub">Neta del período</div>
              </div>
            </div>

            <div class="bi-notebook">
              <div class="bi-nb-topbar">
                <div class="bi-dot" style="background:#ff5f57"></div>
                <div class="bi-dot" style="background:#febc2e"></div>
                <div class="bi-dot" style="background:#28c840"></div>
              </div>
              <div class="bi-nb-screen">
                <div class="bi-screen-header">
                  <span class="bi-screen-title">Dashboard — Abril 2026</span>
                  <span class="bi-screen-badge">Admin</span>
                </div>
                <div class="bi-kpi-row">
                  <div class="bi-kpi-cell">
                    <div class="bi-cell-label">Ingresos</div>
                    <div class="bi-cell-value bi-pos">$284k</div>
                  </div>
                  <div class="bi-kpi-cell">
                    <div class="bi-cell-label">Egresos</div>
                    <div class="bi-cell-value bi-neg">$148k</div>
                  </div>
                  <div class="bi-kpi-cell">
                    <div class="bi-cell-label">Alumnas</div>
                    <div class="bi-cell-value">49</div>
                  </div>
                </div>
                <div class="bi-chart">
                  <div class="bi-chart-label">Ingresos — últimos 6 meses</div>
                  <div class="bi-bars">
                    <div class="bi-bar" style="height:35%"></div>
                    <div class="bi-bar" style="height:50%"></div>
                    <div class="bi-bar" style="height:42%"></div>
                    <div class="bi-bar" style="height:60%"></div>
                    <div class="bi-bar" style="height:54%"></div>
                    <div class="bi-bar bi-bar-active" style="height:88%"></div>
                  </div>
                </div>
                <div class="bi-alert">⚠ 12 alumnas con deuda pendiente</div>
