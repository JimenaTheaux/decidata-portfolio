  <section class="stats" id="stats">
    <div class="stats__grid">
      <div class="stats__item">
        <span class="stats__number" data-target="{{ general.stat1_num }}" data-suffix="{{ general.stat1_suffix }}">0{{ general.stat1_suffix }}</span>
        <span class="stats__label">{{ general.stat1_label }}</span>
        {%- if general.stat1_sublabel %}<span class="stats__sublabel">{{ general.stat1_sublabel }}</span>{%- endif %}
      </div>
      <div class="stats__item">
        <span class="stats__number" data-static="true">{{ general.stat2_display }}</span>
        <span class="stats__label">{{ general.stat2_label }}</span>
        {%- if general.stat2_sublabel %}<span class="stats__sublabel">{{ general.stat2_sublabel }}</span>{%- endif %}
      </div>
      <div class="stats__item">
        <span class="stats__number" data-target="{{ general.stat3_num }}" data-prefix="{{ general.stat3_prefix }}">0</span>
        <span class="stats__label">{{ general.stat3_label }}</span>
        {%- if general.stat3_sublabel %}<span class="stats__sublabel">{{ general.stat3_sublabel }}</span>{%- endif %}
      </div>
      <div class="stats__item">
        <span class="stats__number" data-target="{{ general.stat4_num }}" data-suffix="{{ general.stat4_suffix }}">0{{ general.stat4_suffix }}</span>
        <span class="stats__label">{{ general.stat4_label }}</span>
        {%- if general.stat4_sublabel %}<span class="stats__sublabel">{{ general.stat4_sublabel }}</span>{%- endif %}
      </div>
    </div>
  </section>

  <section id="proyectos" class="proyectos">
    <div class="container">
      <div class="proyectos__header reveal">
        <div class="section-label">{{ general.proyectos_label }}</div>
        <h2 class="section-h2">{{ general.proyectos_h2 }}</h2>
        <p class="section-subtitle">{{ general.proyectos_sub }}</p>
      </div>


      <div class="proyectos__filtros" role="tablist">
        <button class="filtro active" data-filtro="todos" role="tab" aria-selected="true">Todos</button>
        <button class="filtro" data-filtro="gestión" role="tab" aria-selected="false">Gestión</button>
        <button class="filtro" data-filtro="stock" role="tab" aria-selected="false">Stock</button>
        <button class="filtro" data-filtro="pedidos" role="tab" aria-selected="false">Pedidos</button>
      </div>

      <div class="proyectos__grid">
        {%- set proyectosDestacados = [] -%}
        {%- for key, p in proyectos -%}
          {%- if p.destacado -%}
            {%- set proyectosDestacados = (proyectosDestacados.push(p), proyectosDestacados) -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for p in proyectosDestacados | sort(attribute="orden") -%}
        <div class="proyecto-card reveal" data-categoria="{{ p.categoria }}" onclick="openProject({{ loop.index0 }})">
          <div class="card-imagen">
            {%- if p.mockup %}
            <img src="{{ p.mockup }}" alt="Sistema de gestión {{ p.titulo }} — deciDATA" loading="lazy">
            {%- else %}
            <div class="card-imagen-placeholder"><span>{{ p.titulo }}</span></div>
            {%- endif %}
            <span class="card-overlay-cta">Ver caso completo →</span>
          </div>
          <div class="card-contenido">
            <div class="card-meta">
              <span class="card-categoria">{{ p.categoria }}</span>
              <span class="card-anio">2024</span>
            </div>
            <h3 class="card-titulo">{{ p.titulo }}</h3>
            {%- if p.frase_resultado %}<p class="card-frase">{{ p.frase_resultado }}</p>{%- endif %}
            <div class="card-chips">
              {%- for chip in p.chips %}<span class="chip chip--{{ chip | lower | replace(' ', '-') }}">{{ chip }}</span>{%- endfor %}
            </div>
          </div>
        </div>
        {%- endfor %}
      </div>
      <div style="text-align:center;margin-top:40px" class="reveal">
        <a href="/proyectos/" class="btn btn--secondary" style="border-color:rgba(70,154,150,.4);color:var(--accent)">Ver todos los proyectos →</a>
      </div>
    </div>
  </section>

  <section id="valoraciones" class="valoraciones">
    <div class="container">
      {%- set resenasProjects = [] -%}
      {%- for key, p in proyectos -%}
        {%- if p.destacado and p.resena_texto -%}
          {%- set resenasProjects = (resenasProjects.push(p), resenasProjects) -%}
        {%- endif -%}
      {%- endfor -%}
      {%- set resenasOrdenadas = resenasProjects | sort(attribute="orden") -%}
      <div class="valoraciones__header reveal">
        <div class="section-label">{{ general.valoraciones_label }}</div>
        <h2>{{ general.valoraciones_h2 }}</h2>
        <div class="valoraciones__rating">
          <span class="stars" aria-label="5 estrellas">★★★★★</span>
          <span class="rating-text">{{ resenasOrdenadas | length }} proyectos · {{ general.valoraciones_rating }}</span>
        </div>
      </div>
      <div class="valoraciones__slider" id="reviewsSlider">
        <div class="valoraciones__track" id="reviewsTrack">
          {%- for p in resenasOrdenadas -%}
          <article class="review-card">
            <div class="review-comilla" aria-hidden="true">"</div>
            <div class="review-stars" aria-label="5 estrellas">★★★★★</div>
            <p class="review-texto">{{ p.resena_texto }}</p>
            <div class="review-autor">
              <div class="review-avatar" aria-hidden="true">{{ p.resena_avatar or p.resena_nombre | truncate(2, true, '') }}</div>
              <div class="review-info">
                <strong class="review-nombre">{{ p.resena_nombre }}</strong>
                <span class="review-rol">{{ p.resena_rol }}</span>
              </div>
            </div>
          </article>
          {%- endfor -%}
        </div>
      </div>
      <div class="valoraciones__controles" id="reviewsControles">
        <button class="slider-btn slider-btn--prev" aria-label="Review anterior">←</button>
        <div class="slider-dots" id="sliderDots">
          {%- for p in resenasOrdenadas -%}
          <button class="dot{% if loop.first %} active{% endif %}" data-index="{{ loop.index0 }}" aria-label="Review {{ loop.index }}"></button>
          {%- endfor -%}
        </div>
        <button class="slider-btn slider-btn--next" aria-label="Review siguiente">→</button>
      </div>
    </div>
  </section>

  <section id="acerca" class="acerca">
    <div class="acerca__grid">
      <div class="acerca__foto reveal">
        <img src="{{ general.foto_perfil }}"
             alt="{{ general.nombre }}, fundadora de deciDATA — analista de datos"
             width="400" height="480" loading="lazy">
      </div>
      <div class="acerca__contenido reveal">
        <div class="section-label">{{ general.acerca_label }}</div>
        <h2>{{ general.acerca_h2_p1 }}<br><em>{{ general.acerca_h2_em }}</em></h2>
        <p class="acerca__bio">{{ general.bio1 }}</p>
        <p class="acerca__bio acerca__bio--secondary">{{ general.bio2 }}</p>
        <div class="acerca__skills">
          <span class="skill-pill">{{ general.skill1 }}</span>
          <span class="skill-pill">{{ general.skill2 }}</span>
          <span class="skill-pill">{{ general.skill3 }}</span>
          <span class="skill-pill">{{ general.skill4 }}</span>
        </div>
        <div class="acerca__propuesta">
          <div class="propuesta-item"><span class="propuesta-arrow">→</span><strong>{{ general.prop1_negrita }}</strong> → {{ general.prop1_texto }}</div>
          <div class="propuesta-item"><span class="propuesta-arrow">→</span><strong>{{ general.prop2_negrita }}</strong> → {{ general.prop2_texto }}</div>
          <div class="propuesta-item"><span class="propuesta-arrow">→</span><strong>{{ general.prop3_negrita }}</strong> → {{ general.prop3_texto }}</div>
          <div class="propuesta-item"><span class="propuesta-arrow">→</span><strong>{{ general.prop4_negrita }}</strong> → {{ general.prop4_texto }}</div>
        </div>
        <div class="acerca__firma">
          <strong>{{ general.nombre }}</strong>
          <span>{{ general.rol }}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="proceso">
    <div class="container">
      <div class="proceso__header reveal">
        <div class="section-label">{{ general.proceso_label }}</div>
        <h2>{{ general.proceso_h2 }}</h2>
      </div>
      <div class="proceso__timeline">
        <div class="proceso__paso" data-step="1">
          <div class="paso__numero">1</div>
          <div class="paso__icono">{{ general.paso1_icono }}</div>
          <h3>{{ general.paso1_titulo }}</h3>
          <p>{{ general.paso1_desc }}</p>
        </div>
        <div class="proceso__conector" aria-hidden="true"></div>
        <div class="proceso__paso" data-step="2">
          <div class="paso__numero">2</div>
          <div class="paso__icono">{{ general.paso2_icono }}</div>
          <h3>{{ general.paso2_titulo }}</h3>
          <p>{{ general.paso2_desc }}</p>
        </div>
        <div class="proceso__conector" aria-hidden="true"></div>
        <div class="proceso__paso" data-step="3">
          <div class="paso__numero">3</div>
          <div class="paso__icono">{{ general.paso3_icono }}</div>
          <h3>{{ general.paso3_titulo }}</h3>
          <p>{{ general.paso3_desc }}</p>
        </div>
        <div class="proceso__conector" aria-hidden="true"></div>
        <div class="proceso__paso" data-step="4">
          <div class="paso__numero">4</div>
          <div class="paso__icono">{{ general.paso4_icono }}</div>
          <h3>{{ general.paso4_titulo }}</h3>
          <p>{{ general.paso4_desc }}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="contacto" class="contacto">
    <div class="contacto__inner">
      <div class="contacto__badge reveal">{{ general.contacto_badge }}</div>
      <h2 class="reveal">{{ general.contacto_h2 }}</h2>
      <p class="contacto__sub reveal">{{ general.contacto_sub }}</p>
      <div class="contacto__opciones">
        <div class="contacto__whatsapp reveal">
          <a href="https://wa.me/{{ general.whatsapp }}" class="btn-whatsapp" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Escribir por WhatsApp
          </a>
          <span class="contacto__respuesta">{{ general.contacto_respuesta }}</span>
          <div class="contacto__datos">
            <span>📱 {{ general.whatsapp_display }}</span>
            <span>📍 {{ general.contacto_ubicacion }}</span>
          </div>
        </div>
        <div class="contacto__divisor" aria-hidden="true"><span>o</span></div>
        <div class="contacto__form-wrap reveal">
          <h3>Dejame tu consulta</h3>
          <form class="contacto__form" id="contactForm" novalidate>
            <div class="form-group">
              <label for="nombre">Nombre *</label>
              <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre">
            </div>
            <div class="form-group">
              <label for="negocio">Negocio / rubro *</label>
              <input type="text" id="negocio" name="negocio" required placeholder="Ej: Gimnasio, Vivero, Fábrica">
            </div>
            <div class="form-group">
              <label for="problema">¿Cuál es tu problema principal? *</label>
              <textarea id="problema" name="problema" rows="3" required placeholder="Contame qué querés resolver"></textarea>
            </div>
            <div class="form-group">
              <label for="email">Email *</label>
              <input type="email" id="email" name="email" required placeholder="tu@email.com">
            </div>
            <button type="submit" class="btn-submit" id="submitBtn">
              <span class="btn-submit__text">Enviar consulta →</span>
              <span class="btn-submit__loading" hidden>Enviando...</span>
            </button>
            <div class="form-mensaje" id="formMensaje" role="alert" hidden></div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label="deciDATA inicio">
          <span class="logo-deci">deci</span><span class="logo-data">DATA</span>
        </a>
        <p class="footer__tagline">{{ general.footer_tagline }}</p>
        <a href="{{ general.linkedin_url }}" target="_blank" rel="noopener" class="footer__linkedin" aria-label="LinkedIn de deciDATA">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
