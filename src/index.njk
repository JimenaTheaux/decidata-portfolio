<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;overflow-x:hidden}
:root{
  --white:#FFFFFF;--black:#0D0D0D;
  --gray-50:#F7F7F5;--gray-100:#F0F0EE;--gray-200:#E4E4E2;
  --gray-400:#ABABAB;--gray-600:#6B6B6B;
  --accent:#469A96;--accent-light:#E8F4F3;--accent-dark:#2D706D;
  --font-main:'IBM Plex Sans',sans-serif;--font-mono:'IBM Plex Mono',monospace;
  --nav-h:64px;--max-w:1140px;--px:clamp(20px,5vw,60px);
  --radius:10px;--radius-lg:16px;
}
body{font-family:var(--font-main);background:var(--white);color:var(--black);font-size:16px;line-height:1.6;overflow-x:hidden;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%;height:auto}
a{text-decoration:none;color:inherit}
.container{max-width:var(--max-w);margin:0 auto;padding:0 var(--px)}
.section-label{font-family:var(--font-mono);font-size:11px;color:var(--accent);letter-spacing:.14em;text-transform:uppercase;display:flex;align-items:center;gap:10px;margin-bottom:20px}
.section-label::before{content:'';width:24px;height:1px;background:var(--accent);flex-shrink:0}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .65s ease,transform .65s ease}
.reveal.visible{opacity:1;transform:translateY(0)}

/* NAV */
#nav{position:fixed;top:0;left:0;right:0;height:var(--nav-h);background:transparent;z-index:200;transition:background 300ms ease,backdrop-filter 300ms ease,box-shadow 300ms ease,border-bottom-color 300ms ease}
#nav.scrolled{background:rgba(255,255,255,.97);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--gray-200);box-shadow:0 1px 20px rgba(0,0,0,.06)}
.nav-inner{height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;gap:24px}
.nav-logo{display:flex;align-items:center;flex-shrink:0}
.logo-deci{font-family:var(--font-mono);font-size:18px;font-weight:700;color:var(--black);letter-spacing:-.02em}
.logo-data{font-family:var(--font-mono);font-size:18px;font-weight:700;color:var(--accent);letter-spacing:-.02em}
.nav-links{display:flex;align-items:center;gap:32px;list-style:none}
.nav-link{font-size:13.5px;color:var(--gray-600);font-weight:400;white-space:nowrap;position:relative;padding-bottom:3px;transition:color .2s}
.nav-link:hover{color:var(--black)}
.nav-link::after{content:'';position:absolute;bottom:0;left:0;width:100%;height:2px;background:var(--accent);transform:scaleX(0);transform-origin:left;transition:transform 250ms ease}
.nav-link.active{color:var(--black)}
.nav-link.active::after{transform:scaleX(1)}
.nav-cta{font-size:13px;font-weight:500;color:var(--accent);border:1.5px solid var(--accent);padding:8px 20px;border-radius:6px;transition:background .2s,color .2s;white-space:nowrap;flex-shrink:0}
.nav-cta:hover{background:var(--accent);color:var(--white)}
.hamburger{display:none;flex-direction:column;justify-content:center;gap:5px;cursor:pointer;padding:6px;background:none;border:none;width:36px;height:36px;flex-shrink:0}
.hamburger span{display:block;width:22px;height:1.5px;background:var(--black);border-radius:2px;transition:transform .3s ease,opacity .3s ease}
.hamburger.open span:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.hamburger.open span:nth-child(2){opacity:0;transform:scaleX(0)}
.hamburger.open span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
.nav-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:300}
.nav-overlay.open{display:block}
.nav-drawer{position:fixed;top:0;right:0;height:100vh;width:280px;background:var(--white);border-left:1px solid var(--gray-200);padding:80px 32px 32px;z-index:301;transform:translateX(100%);transition:transform .35s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;box-shadow:-8px 0 32px rgba(0,0,0,.08)}
.nav-drawer.open{transform:translateX(0)}
.drawer-links{list-style:none;display:flex;flex-direction:column;flex:1}
.drawer-link{font-size:1.5rem;font-weight:500;color:var(--black);min-height:48px;display:flex;align-items:center;border-bottom:1px solid var(--gray-100);transition:color .2s}
.drawer-link:hover{color:var(--accent)}
.drawer-cta{display:block;margin-top:24px;background:var(--accent);color:var(--white);font-size:14px;font-weight:500;text-align:center;padding:14px 20px;border-radius:7px;transition:background .2s}
.drawer-cta:hover{background:var(--accent-dark)}

/* NAV — over dark hero */
#nav:not(.scrolled) .logo-deci{color:#fff}
#nav:not(.scrolled) .logo-data{color:var(--accent)}
#nav:not(.scrolled) .nav-link{color:rgba(255,255,255,.7)}
#nav:not(.scrolled) .nav-link:hover{color:#fff}
#nav:not(.scrolled) .nav-link.active{color:#fff}
#nav:not(.scrolled) .nav-cta{color:var(--accent);border-color:rgba(70,154,150,.55)}
#nav:not(.scrolled) .hamburger span{background:#fff}

/* HERO */
#hero{padding-top:var(--nav-h);background:#0f172a;position:relative;overflow:hidden}
#hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 65% 50% at 82% 30%,rgba(70,154,150,.09),transparent);pointer-events:none}
#hero::after{content:'';position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.035) 1px,transparent 1px);background-size:28px 28px;pointer-events:none}
.hero{padding:clamp(64px,8vw,100px) 0 clamp(80px,10vw,120px);position:relative;z-index:1}
.hero-grid{display:grid;grid-template-columns:55fr 45fr;gap:clamp(32px,6vw,80px);align-items:center}
.hero__eyebrow{display:inline-flex;font-family:var(--font-mono);font-size:.75rem;text-transform:uppercase;letter-spacing:.12em;color:var(--accent);background:rgba(70,154,150,.1);border:1px solid rgba(70,154,150,.35);border-radius:999px;padding:4px 14px;margin-bottom:24px;animation:heroFadeDown .6s ease both 0ms}
.hero__title{font-size:clamp(32px,5.5vw,58px);font-weight:600;line-height:1.08;letter-spacing:-.03em;color:#fff;margin-bottom:20px;animation:heroFadeUp .6s ease both 100ms}
.hero__highlight{background:linear-gradient(90deg,#fff 0%,var(--accent) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero__subtitle{font-size:clamp(15px,1.8vw,17px);color:rgba(255,255,255,.6);line-height:1.75;max-width:480px;margin-bottom:36px;font-weight:300;animation:heroFadeUp .6s ease both 200ms}
.hero__ctas{display:flex;align-items:center;gap:16px;flex-wrap:wrap;animation:heroFadeUp .6s ease both 300ms}
.btn{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:600;padding:13px 26px;border-radius:8px;transition:all .2s;white-space:nowrap}
.btn--primary{background:var(--accent);color:#0f172a}
.btn--primary:hover{filter:brightness(1.12);transform:translateY(-1px)}
.btn--secondary{border:1.5px solid rgba(255,255,255,.3);color:rgba(255,255,255,.85)}
.btn--secondary:hover{border-color:var(--accent);color:var(--accent)}
.hero__proof{font-family:var(--font-mono);font-size:.8rem;color:rgba(255,255,255,.42);margin-top:20px;letter-spacing:.04em;animation:heroFadeUp .6s ease both 300ms}
.hero__dashboard{animation:heroSlideRight .7s ease both 400ms}
@keyframes heroFadeDown{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:translateY(0)}}
@keyframes heroFadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes heroSlideRight{from{opacity:0;transform:translateX(32px)}to{opacity:1;transform:translateX(0)}}

/* STATS */
.stats{background:#111827;padding:64px 0}
.stats__grid{display:grid;grid-template-columns:repeat(4,1fr);max-width:var(--max-w);margin:0 auto;padding:0 var(--px)}
.stats__item{display:flex;flex-direction:column;padding:0 clamp(16px,3vw,40px);border-right:1px solid rgba(255,255,255,.08);opacity:0;transform:translateY(20px);transition:opacity 500ms ease,transform 500ms ease}
.stats__item:first-child{padding-left:0}
.stats__item:last-child{border-right:none;padding-right:0}
.stats__number{font-size:clamp(2.5rem,5vw,3.5rem);font-weight:800;color:var(--accent);line-height:1;display:block;transition:transform 200ms ease}
.stats__item:hover .stats__number{transform:scale(1.05)}
.stats__label{font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.6);margin-top:8px}
.stats__sublabel{font-size:.7rem;color:rgba(255,255,255,.35);margin-top:4px}
@media(max-width:768px){
  .stats__grid{grid-template-columns:1fr 1fr}
  .stats__item{padding:clamp(24px,4vw,36px) clamp(16px,4vw,32px)}
  .stats__item:first-child{padding-left:clamp(16px,4vw,32px)}
  .stats__item:last-child{padding-right:clamp(16px,4vw,32px)}
  .stats__item:nth-child(2){border-right:none}
  .stats__item:nth-child(3){border-right:1px solid rgba(255,255,255,.08)}
  .stats__item:nth-child(4){border-right:none}
  .stats__item:nth-child(1),.stats__item:nth-child(2){border-bottom:1px solid rgba(255,255,255,.08);padding-bottom:clamp(24px,4vw,36px)}
  .stats__item:nth-child(3),.stats__item:nth-child(4){padding-top:clamp(24px,4vw,36px)}
}
@media(max-width:480px){
  .stats__grid{grid-template-columns:1fr}
  .stats__item{border-right:none;border-bottom:1px solid rgba(255,255,255,.08);padding:24px 0}
  .stats__item:last-child{border-bottom:none}
}

/* PROJECTS */
.section-h2{font-size:clamp(26px,4vw,40px);font-weight:600;line-height:1.15;letter-spacing:-.025em;margin-bottom:14px}
.proyectos{padding:clamp(64px,10vw,120px) 0;background:#0f172a}
.proyectos__header{margin-bottom:clamp(32px,5vw,48px)}
.proyectos .section-label{color:rgba(255,255,255,.4)}
.proyectos .section-label::before{background:rgba(255,255,255,.25)}
.proyectos .section-h2{color:#fff}
.section-subtitle{font-size:15px;color:rgba(255,255,255,.5);font-weight:300;max-width:460px;line-height:1.7}
.proyectos__filtros{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:clamp(32px,5vw,48px)}
.filtro{border:1.5px solid rgba(255,255,255,.2);color:rgba(255,255,255,.6);background:transparent;border-radius:999px;padding:8px 20px;cursor:pointer;font-size:13px;font-family:var(--font-main);font-weight:400;transition:all 200ms}
.filtro:hover{border-color:var(--accent);color:var(--accent)}
.filtro.active{background:var(--accent);color:#0f172a;border-color:var(--accent);font-weight:700}
.proyectos__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.proyecto-card{background:rgba(30,41,59,.6);border:1px solid rgba(255,255,255,.08);border-radius:16px;overflow:hidden;cursor:pointer;transition:transform 300ms,box-shadow 300ms,border-color 300ms,opacity 200ms,scale 200ms}
.proyecto-card:hover{transform:translateY(-4px);box-shadow:0 16px 48px rgba(70,154,150,.12);border-color:rgba(70,154,150,.3)}
.proyecto-card.oculta{opacity:0;scale:.95;pointer-events:none}
.card-imagen{position:relative;overflow:hidden}
.card-imagen img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}
.card-imagen::after{content:'';position:absolute;inset:0;background:rgba(0,0,0,0);transition:background 300ms;z-index:0}
.proyecto-card:hover .card-imagen::after{background:rgba(0,0,0,.55)}
.card-overlay-cta{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:#fff;font-size:14px;font-weight:600;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity 300ms;z-index:1}
.proyecto-card:hover .card-overlay-cta{opacity:1}
.card-imagen-placeholder{aspect-ratio:16/9;background:rgba(255,255,255,.04);display:flex;align-items:center;justify-content:center}
.card-imagen-placeholder span{font-family:var(--font-mono);font-size:12px;color:rgba(255,255,255,.3)}
.card-contenido{padding:20px}
.card-meta{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.card-categoria{font-family:var(--font-mono);font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--accent)}
.card-anio{font-family:var(--font-mono);font-size:10px;color:rgba(255,255,255,.35)}
.card-titulo{font-size:1.25rem;font-weight:700;color:#fff;margin-bottom:8px;line-height:1.25;letter-spacing:-.02em}
.card-frase{font-size:.9rem;font-style:italic;color:rgba(255,255,255,.55);margin-bottom:14px;line-height:1.55}
.card-chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{font-family:var(--font-mono);font-size:.7rem;padding:4px 10px;border-radius:4px;background:rgba(255,255,255,.08);color:rgba(255,255,255,.6)}
.chip--dashboard,.chip--whatsapp,.chip--deudas{background:rgba(59,130,246,.15);color:#93c5fd}
.chip--pagos,.chip--ventas{background:rgba(34,197,94,.15);color:#86efac}
.chip--stock,.chip--egresos,.chip--alertas{background:rgba(234,179,8,.15);color:#fde047}
.chip--pedidos,.chip--roles,.chip--factura,.chip--reparto{background:rgba(168,85,247,.15);color:#d8b4fe}
@media(max-width:768px){.proyectos__grid{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.proyectos__grid{grid-template-columns:1fr}}

/* DETAIL */
#project-detail{display:none;padding-top:calc(var(--nav-h) + 48px);padding-bottom:80px;min-height:100vh}
#project-detail.active{display:block}
.detail-back{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--gray-600);margin-bottom:40px;cursor:pointer;transition:color .2s;border:none;background:none;font-family:var(--font-main)}
.detail-back:hover{color:var(--black)}
.detail-header{max-width:680px;margin-bottom:48px}
.detail-logo{height:48px;width:auto;max-width:180px;object-fit:contain;margin-bottom:20px;border-radius:6px}
.detail-tag{font-family:var(--font-mono);font-size:11px;color:var(--gray-600);letter-spacing:.1em;text-transform:uppercase;margin-bottom:12px}
.detail-title{font-size:clamp(28px,4vw,44px);font-weight:600;letter-spacing:-.03em;line-height:1.1;margin-bottom:20px}
.detail-desc{font-size:16px;color:var(--gray-600);line-height:1.75;font-weight:300}
.detail-mockup{width:100%;max-width:800px;border-radius:12px;border:1px solid var(--gray-200);margin-bottom:40px;box-shadow:0 4px 24px rgba(0,0,0,.08)}
.detail-quote{border-left:3px solid var(--accent);padding:20px 24px;background:var(--gray-50);border-radius:0 8px 8px 0;margin:36px 0}
.detail-quote p{font-size:clamp(16px,2.5vw,20px);font-weight:300;font-style:italic;color:var(--black);line-height:1.6}
.detail-quote cite{display:block;font-size:12px;font-family:var(--font-mono);color:var(--gray-600);margin-top:10px;font-style:normal}
.detail-section-title{font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--gray-600);margin-bottom:20px;display:flex;align-items:center;gap:12px}
.detail-section-title::after{content:'';flex:1;height:1px;background:var(--gray-200)}
.detail-problem{font-size:15px;color:var(--black);line-height:1.8;max-width:640px;margin-bottom:40px;font-weight:300}
.features-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;margin-bottom:40px}
.feature-chip{display:flex;align-items:center;gap:10px;background:var(--gray-50);border:1px solid var(--gray-200);border-radius:8px;padding:12px 14px;font-size:13.5px;color:var(--black)}
.feature-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0}
.results-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:40px}
.result-card{background:var(--gray-50);border:1px solid var(--gray-200);border-radius:10px;padding:22px 18px;border-top:3px solid var(--accent)}
.result-text{font-size:14px;color:var(--black);line-height:1.6}
.solution-tag{display:inline-flex;align-items:center;gap:8px;background:var(--accent-light);color:var(--accent-dark);font-family:var(--font-mono);font-size:11px;padding:8px 16px;border-radius:6px}

/* ABOUT */
.acerca{padding:clamp(64px,10vw,120px) 0;background:#0f172a}
.acerca .section-label{color:rgba(255,255,255,.4)}
.acerca .section-label::before{background:rgba(255,255,255,.25)}
.acerca__grid{display:grid;grid-template-columns:2fr 3fr;gap:clamp(48px,8vw,96px);align-items:center;max-width:var(--max-w);margin:0 auto;padding:0 var(--px)}
.acerca__foto img{width:100%;border-radius:20px;border:1px solid rgba(70,154,150,.2);box-shadow:0 0 40px rgba(70,154,150,.08);display:block}
.acerca__contenido h2{font-size:clamp(26px,4vw,40px);font-weight:600;line-height:1.15;letter-spacing:-.025em;color:#fff;margin-bottom:24px}
.acerca__contenido h2 em{font-style:italic;color:var(--accent)}
.acerca__bio{font-size:15px;color:rgba(255,255,255,.65);line-height:1.8;font-weight:300;margin-bottom:12px}
.acerca__bio--secondary{color:rgba(255,255,255,.45);font-size:14px}
.acerca__skills{display:flex;flex-wrap:wrap;margin:20px 0}
.skill-pill{display:inline-flex;align-items:center;border:1px solid rgba(255,255,255,.15);border-radius:999px;padding:6px 16px;font-size:.85rem;color:rgba(255,255,255,.8);margin:4px;background:rgba(255,255,255,.05)}
.acerca__propuesta{margin:20px 0}
.propuesta-item{display:flex;align-items:baseline;padding:10px 14px;border-radius:8px;font-size:14px;color:rgba(255,255,255,.7);transition:background 150ms;line-height:1.5}
.propuesta-item:hover{background:rgba(255,255,255,.04)}
.propuesta-arrow{color:var(--accent);font-weight:700;margin-right:10px;flex-shrink:0}
.propuesta-item strong{color:#fff;font-weight:600;margin-right:4px}
.acerca__firma{margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,255,255,.1);display:flex;flex-direction:column;gap:4px}
.acerca__firma strong{color:#fff;font-size:15px;font-weight:600}
.acerca__firma span{font-size:13px;color:rgba(255,255,255,.45);font-family:var(--font-mono)}
@media(max-width:768px){.acerca__grid{grid-template-columns:1fr;gap:40px}}
@media(max-width:600px){.acerca__foto{display:none}}

/* PROCESO */
.proceso{padding:clamp(64px,10vw,120px) 0;background:#111827}
.proceso .section-label{color:rgba(255,255,255,.4)}
.proceso .section-label::before{background:rgba(255,255,255,.25)}
.proceso__header{text-align:center;margin-bottom:clamp(40px,6vw,56px)}
.proceso__header h2{font-size:clamp(26px,4vw,40px);font-weight:600;line-height:1.15;letter-spacing:-.025em;color:#fff;margin-top:8px}
.proceso__timeline{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;align-items:center}
.proceso__conector{border-top:2px dashed rgba(70,154,150,.3);align-self:center;min-width:16px;margin:0 8px}
.proceso__paso{text-align:center;padding:24px 16px;background:rgba(30,41,59,.5);border:1px solid rgba(255,255,255,.08);border-radius:16px;opacity:0;transform:translateY(24px);transition:opacity 500ms ease,transform 500ms ease}
.proceso__paso.visible{opacity:1;transform:none}
.paso__numero{width:36px;height:36px;background:var(--accent);color:#0f172a;font-weight:800;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:14px;font-family:var(--font-mono)}
.paso__icono{font-size:2rem;margin-bottom:12px;line-height:1}
.proceso__paso h3{font-size:1rem;font-weight:700;color:#fff;margin-bottom:8px}
.proceso__paso p{font-size:.875rem;color:rgba(255,255,255,.6);line-height:1.6}
@media(max-width:768px){
  .proceso__timeline{grid-template-columns:1fr;gap:16px}
  .proceso__conector{display:none}
}

/* TESTIMONIALS */
#valoraciones{padding:clamp(64px,10vw,120px) 0;overflow:hidden}
.test-header{margin-bottom:48px}
.test-track{overflow:hidden;position:relative}
.test-track::before,.test-track::after{content:'';position:absolute;top:0;bottom:0;width:80px;z-index:2;pointer-events:none}
.test-track::before{left:0;background:linear-gradient(90deg,var(--white),transparent)}
.test-track::after{right:0;background:linear-gradient(-90deg,var(--white),transparent)}
.test-inner{display:flex;gap:18px;animation:slide 22s linear infinite;width:max-content}
.test-inner:hover{animation-play-state:paused}
@keyframes slide{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.test-card{width:320px;flex-shrink:0;background:var(--white);border:1px solid var(--gray-200);border-radius:var(--radius-lg);padding:28px 26px;transition:border-color .25s}
.test-card:hover{border-color:var(--accent)}
.test-quote-mark{font-family:Georgia,serif;font-size:48px;line-height:1;color:var(--accent);opacity:.3;margin-bottom:-8px;margin-left:-4px}
.test-text{font-size:14px;color:var(--black);line-height:1.75;font-weight:300;font-style:italic;margin-bottom:22px}
.test-author{display:flex;align-items:center;gap:12px;border-top:1px solid var(--gray-100);padding-top:18px}
.test-avatar{width:38px;height:38px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:12px;color:var(--white);background:var(--accent);flex-shrink:0}
.test-name{font-size:13.5px;font-weight:500}
.test-role{font-size:11px;color:var(--gray-600);font-family:var(--font-mono)}

/* CTA */
#contacto{padding:clamp(64px,10vw,120px) 0;background:var(--accent-light);border-top:1px solid rgba(70,154,150,.25);border-bottom:1px solid rgba(70,154,150,.25)}
.cta-box{border-radius:16px;padding:clamp(40px,8vw,80px);text-align:center}
.cta-h2{font-size:clamp(24px,4vw,42px);font-weight:600;letter-spacing:-.03em;color:var(--black);line-height:1.15;margin-bottom:16px}
.cta-h2 em{color:var(--accent);font-style:italic;font-weight:300}
.cta-sub{font-size:15px;color:var(--gray-600);font-weight:300;line-height:1.7;max-width:460px;margin:0 auto 36px}
.cta-actions{display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap}
.btn-whatsapp{display:inline-flex;align-items:center;gap:9px;background:#25D366;color:var(--white);font-size:14px;font-weight:500;padding:13px 26px;border-radius:7px;transition:all .2s}
.btn-whatsapp:hover{transform:translateY(-1px)}
.btn-light{display:inline-flex;align-items:center;gap:7px;color:var(--accent);font-size:14px;border:1px solid var(--accent);padding:12px 24px;border-radius:7px;transition:all .2s;background:transparent}
.btn-light:hover{background:var(--accent);color:var(--white)}

/* FAB WhatsApp */
.fab-wa{position:fixed;bottom:24px;right:24px;width:56px;height:56px;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(37,211,102,.4);z-index:500;transition:transform .2s,box-shadow .2s;opacity:0;animation:fabIn .5s .4s ease forwards;text-decoration:none}
.fab-wa:hover{transform:scale(1.08);box-shadow:0 8px 28px rgba(37,211,102,.55)}
.fab-wa svg{width:28px;height:28px;fill:#fff;flex-shrink:0}
.fab-wa::after{content:'Hablemos';position:absolute;right:64px;top:50%;transform:translateY(-50%);background:var(--black);color:var(--white);font-size:12px;font-family:var(--font-main);font-weight:500;padding:6px 12px;border-radius:6px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .2s;box-shadow:0 2px 8px rgba(0,0,0,.15)}
.fab-wa:hover::after{opacity:1}
@keyframes fabIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:600px){.fab-wa::after{display:none}}

/* FOOTER */
footer{padding:32px var(--px);border-top:1px solid var(--gray-200);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px}
.footer-text{font-family:var(--font-mono);font-size:11px;color:var(--gray-400);letter-spacing:.06em}

/* RESPONSIVE */
@media(max-width:900px){
  .nav-links{display:none}.hamburger{display:flex}.nav-cta{display:none}
  .hero-grid{grid-template-columns:1fr}.hero__dashboard{margin-top:8px}
  .results-grid{grid-template-columns:1fr}
  .features-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:600px){
  :root{--px:18px}
  .features-grid{grid-template-columns:1fr}
  .cta-box{padding:36px 24px;border-radius:14px}
  footer{flex-direction:column;align-items:flex-start}
  .test-card{width:280px}
}

/* ── HERO BI SCENE ── */
.hero-bi-scene{display:flex;align-items:flex-start;gap:16px;background:#F5F2EC;border-radius:20px;padding:28px 20px;width:100%;box-shadow:0 4px 32px rgba(0,0,0,.06);transition:transform .3s ease,box-shadow .3s ease}
.hero__dashboard:hover .hero-bi-scene{transform:translateY(-4px);box-shadow:0 20px 60px rgba(0,0,0,.14),0 0 0 1px rgba(70,154,150,.18)}
.bi-sidebar{display:flex;flex-direction:column;gap:10px;flex-shrink:0;width:108px}
.bi-kpi-card{background:#FFFFFF;border:0.5px solid #E8E4DC;border-radius:10px;padding:11px 11px 9px;border-top-width:3px;border-top-style:solid}
.bi-kpi-teal{border-top-color:#469A96}
.bi-kpi-amber{border-top-color:#BA7517}
.bi-kpi-slate{border-top-color:#534AB7}
.bi-kpi-label{font-family:var(--font-mono);font-size:8px;color:#888780;letter-spacing:.06em;text-transform:uppercase;margin-bottom:4px}
.bi-kpi-value{font-family:var(--font-mono);font-size:15px;color:#2C2C2A;line-height:1;margin-bottom:4px;font-weight:600}
.bi-kpi-sub{font-size:8.5px;color:#888780;line-height:1.3}
.bi-notebook{background:#FFFFFF;border:1px solid #E8E4DC;border-radius:12px;padding:12px 12px 14px;flex:1;min-width:0;box-shadow:0 2px 16px rgba(0,0,0,.06),0 0 0 0.5px #E0DDD6}
.bi-nb-topbar{display:flex;align-items:center;gap:5px;margin-bottom:10px}
.bi-dot{width:8px;height:8px;border-radius:50%}
.bi-nb-screen{background:#FAFAF8;border:0.5px solid #EDEBE5;border-radius:7px;padding:11px}
.bi-screen-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.bi-screen-title{font-family:var(--font-mono);font-size:9px;color:#2C2C2A}
.bi-screen-badge{font-family:var(--font-mono);font-size:8px;color:#469A96;background:#E8F4F3;padding:2px 8px;border-radius:3px}
.bi-kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:10px}
.bi-kpi-cell{background:#F0EDE6;border-radius:5px;padding:7px 8px}
.bi-cell-label{font-family:var(--font-mono);font-size:7px;color:#888780;margin-bottom:3px}
.bi-cell-value{font-family:var(--font-mono);font-size:12px;color:#2C2C2A}
.bi-pos{color:#469A96}
.bi-neg{color:#C0392B}
.bi-chart{background:#F0EDE6;border-radius:5px;padding:8px 8px 4px;margin-bottom:8px}
.bi-chart-label{font-family:var(--font-mono);font-size:7px;color:#888780;margin-bottom:6px}
.bi-bars{display:flex;align-items:flex-end;gap:4px;height:38px}
.bi-bar{flex:1;border-radius:2px 2px 0 0;background:#D3D1C7}
.bi-bar-active{background:#469A96}
.bi-alert{background:#FEF9EC;border-left:2.5px solid #E8A000;border-radius:0 4px 4px 0;padding:6px 8px;font-family:var(--font-mono);font-size:8px;color:#7A5F00}
/* phone: ancho fijo, alto automático por contenido, no estira */
.bi-phone{background:#2C2C2A;border-radius:18px;padding:8px 5px 10px;width:80px;flex-shrink:0;align-self:center;border:1.5px solid #3E3E3C;box-shadow:0 6px 24px rgba(0,0,0,.18)}
.bi-phone-notch{width:20px;height:3px;background:#3E3E3C;border-radius:3px;margin:0 auto 5px}
.bi-phone-screen{background:#FFFFFF;border-radius:9px;padding:9px 7px}
.bi-ph-label{font-family:var(--font-mono);font-size:6.5px;color:#888780;margin-bottom:5px;text-transform:uppercase;letter-spacing:.05em}
.bi-ph-row{display:flex;align-items:center;justify-content:space-between;padding:3.5px 0;border-bottom:0.5px solid #F0EDE6}
.bi-ph-row:last-child{border-bottom:none}
.bi-ph-name{font-size:7px;color:#2C2C2A;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:42px}
.bi-ph-tag{font-family:var(--font-mono);font-size:5.5px;padding:2px 4px;border-radius:3px;white-space:nowrap}
.bi-tag-ok{background:#E8F4F3;color:#2D706D}
.bi-tag-no{background:#FEECEC;color:#A82020}
@media(max-width:900px){
  .hero-bi-scene{flex-direction:column;gap:12px;padding:20px 16px}
  .bi-sidebar{flex-direction:row;width:100%}
  .bi-kpi-card{flex:1}
  .bi-phone{display:none}
  .bi-notebook{width:100%}
}
@media(max-width:600px){
  .bi-sidebar{display:none}
}
</style>
</head>
<body>

<nav id="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo" aria-label="deciDATA — inicio">
      <span class="logo-deci">deci</span><span class="logo-data">DATA</span>
    </a>
    <ul class="nav-links">
      <li><a href="#proyectos" class="nav-link" data-section="proyectos">Proyectos</a></li>
      <li><a href="#acerca" class="nav-link" data-section="acerca">Sobre mí</a></li>
      <li><a href="#valoraciones" class="nav-link" data-section="valoraciones">Valoraciones</a></li>
      <li><a href="#contacto" class="nav-link" data-section="contacto">Contacto</a></li>
    </ul>
    <a href="https://wa.me/{{ general.whatsapp }}" target="_blank" class="nav-cta" rel="noopener">Hablemos →</a>
    <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="nav-overlay" id="nav-overlay"></div>
<div class="nav-drawer" id="nav-drawer" aria-hidden="true">
  <ul class="drawer-links">
    <li><a href="#proyectos" class="drawer-link" data-section="proyectos">Proyectos</a></li>
    <li><a href="#acerca" class="drawer-link" data-section="acerca">Sobre mí</a></li>
    <li><a href="#valoraciones" class="drawer-link" data-section="valoraciones">Valoraciones</a></li>
    <li><a href="#contacto" class="drawer-link" data-section="contacto">Contacto</a></li>
  </ul>
  <a href="https://wa.me/{{ general.whatsapp }}" target="_blank" class="drawer-cta" rel="noopener">Hablemos por WhatsApp →</a>
</div>

<div id="main-content">

  <section id="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero__content">
          <span class="hero__eyebrow">Datos · Decisiones · Resultados</span>
          <h1 class="hero__title">Datos que se convierten en<br><span class="hero__highlight">decisiones.</span></h1>
          <p class="hero__subtitle">Transformamos información desordenada en sistemas claros que te permiten gestionar tu negocio con confianza.</p>
          <div class="hero__ctas">
            <a href="#proyectos" class="btn btn--primary nav-anchor">Ver proyectos →</a>
            <a href="https://wa.me/{{ general.whatsapp }}" target="_blank" class="btn btn--secondary" rel="noopener">Contactar →</a>
          </div>
          <p class="hero__proof">✓ +15 negocios &nbsp;·&nbsp; ✓ 100% personalizado &nbsp;·&nbsp; ✓ 10–20 días</p>
        </div>
        <div class="hero__dashboard">
          <div class="hero-bi-scene">

            <div class="bi-sidebar">
              <div class="bi-kpi-card bi-kpi-teal">
                <div class="bi-kpi-label">Ingresos</div>
                <div class="bi-kpi-value" data-count="284000" data-prefix="$">$284k</div>
                <div class="bi-kpi-sub">↑ 12% vs mes anterior</div>
              </div>
              <div class="bi-kpi-card bi-kpi-amber">
                <div class="bi-kpi-label">Egresos</div>
                <div class="bi-kpi-value" data-count="148000" data-prefix="$">$148k</div>
                <div class="bi-kpi-sub">↓ 3% vs mes anterior</div>
              </div>
              <div class="bi-kpi-card bi-kpi-slate">
                <div class="bi-kpi-label">Ganancia</div>
                <div class="bi-kpi-value" data-count="135000" data-prefix="$">$135k</div>
                <div class="bi-kpi-sub">Neta del período</div>
              </div>
            </div>

            <div class="bi-notebook">
              <div class="bi-nb-topbar">
                <div class="bi-dot" style="background:#ff5f57"></div>
                <div class="bi-dot" style="background:#febc2e"></div>
                <div class="bi-dot" style="background:#28c840"></div>
              </div>
              <div class="bi-nb-screen">
                <div class="bi-screen-header">
                  <span class="bi-screen-title">Dashboard — Abril 2026</span>
                  <span class="bi-screen-badge">Admin</span>
                </div>
                <div class="bi-kpi-row">
                  <div class="bi-kpi-cell">
                    <div class="bi-cell-label">Ingresos</div>
                    <div class="bi-cell-value bi-pos">$284k</div>
                  </div>
                  <div class="bi-kpi-cell">
                    <div class="bi-cell-label">Egresos</div>
                    <div class="bi-cell-value bi-neg">$148k</div>
                  </div>
                  <div class="bi-kpi-cell">
                    <div class="bi-cell-label">Alumnas</div>
                    <div class="bi-cell-value">49</div>
                  </div>
                </div>
                <div class="bi-chart">
                  <div class="bi-chart-label">Ingresos — últimos 6 meses</div>
                  <div class="bi-bars">
                    <div class="bi-bar" style="height:35%"></div>
                    <div class="bi-bar" style="height:50%"></div>
                    <div class="bi-bar" style="height:42%"></div>
                    <div class="bi-bar" style="height:60%"></div>
                    <div class="bi-bar" style="height:54%"></div>
                    <div class="bi-bar bi-bar-active" style="height:88%"></div>
                  </div>
                </div>
                <div class="bi-alert">⚠ 12 alumnas con deuda pendiente</div>
              </div>
            </div>

            <div class="bi-phone">
              <div class="bi-phone-notch"></div>
              <div class="bi-phone-screen">
                <div class="bi-ph-label">Estado alumnas</div>
                <div class="bi-ph-row">
                  <span class="bi-ph-name">M. García</span>
                  <span class="bi-ph-tag bi-tag-ok">Pagó</span>
                </div>
                <div class="bi-ph-row">
                  <span class="bi-ph-name">S. Rodríguez</span>
                  <span class="bi-ph-tag bi-tag-ok">Pagó</span>
                </div>
                <div class="bi-ph-row">
                  <span class="bi-ph-name">L. Castro</span>
                  <span class="bi-ph-tag bi-tag-no">Debe</span>
                </div>
                <div class="bi-ph-row">
                  <span class="bi-ph-name">C. Méndez</span>
                  <span class="bi-ph-tag bi-tag-ok">Pagó</span>
                </div>
                <div class="bi-ph-row" style="border:none">
                  <span class="bi-ph-name">A. Fernández</span>
                  <span class="bi-ph-tag bi-tag-no">Debe</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="stats" id="stats">
    <div class="stats__grid">
      <div class="stats__item">
        <span class="stats__number" data-target="10" data-suffix="+">0+</span>
        <span class="stats__label">Proyectos entregados</span>
      </div>
      <div class="stats__item">
        <span class="stats__number" data-static="true">10–20</span>
        <span class="stats__label">Días de entrega</span>
        <span class="stats__sublabel">de diagnóstico a entrega</span>
      </div>
      <div class="stats__item">
        <span class="stats__number" data-target="15" data-prefix="+">0</span>
        <span class="stats__label">Personas confiando</span>
        <span class="stats__sublabel">pymes e instituciones</span>
      </div>
      <div class="stats__item">
        <span class="stats__number" data-target="100" data-suffix="%">0%</span>
        <span class="stats__label">Soluciones personalizadas</span>
      </div>
    </div>
  </section>

  <section id="proyectos" class="proyectos">
    <div class="container">
      <div class="proyectos__header reveal">
        <div class="section-label">Proyectos</div>
        <h2 class="section-h2">Sistemas reales<br>para negocios reales.</h2>
        <p class="section-subtitle">Cada proyecto arranca de un problema concreto. Sin templates.</p>
      </div>

      <div class="proyectos__filtros" role="tablist">
        <button class="filtro active" data-filtro="todos" role="tab" aria-selected="true">Todos</button>
        <button class="filtro" data-filtro="gestión" role="tab" aria-selected="false">Gestión</button>
        <button class="filtro" data-filtro="stock" role="tab" aria-selected="false">Stock</button>
        <button class="filtro" data-filtro="pedidos" role="tab" aria-selected="false">Pedidos</button>
      </div>

      <div class="proyectos__grid">
        {%- set proyectosDestacados = [] -%}
        {%- for key, p in proyectos -%}
          {%- if p.destacado -%}
            {%- set proyectosDestacados = (proyectosDestacados.push(p), proyectosDestacados) -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for p in proyectosDestacados | sort(attribute="orden") -%}
        <div class="proyecto-card reveal" data-categoria="{{ p.categoria }}" onclick="openProject({{ loop.index0 }})">
          <div class="card-imagen">
            {%- if p.mockup %}
            <img src="{{ p.mockup }}" alt="Sistema de gestión {{ p.titulo }} — deciDATA" loading="lazy">
            {%- else %}
            <div class="card-imagen-placeholder"><span>{{ p.titulo }}</span></div>
            {%- endif %}
            <span class="card-overlay-cta">Ver caso completo →</span>
          </div>
          <div class="card-contenido">
            <div class="card-meta">
              <span class="card-categoria">{{ p.categoria }}</span>
              <span class="card-anio">2024</span>
            </div>
            <h3 class="card-titulo">{{ p.titulo }}</h3>
            {%- if p.frase_resultado %}<p class="card-frase">{{ p.frase_resultado }}</p>{%- endif %}
            <div class="card-chips">
              {%- for chip in p.chips %}<span class="chip chip--{{ chip | lower | replace(' ', '-') }}">{{ chip }}</span>{%- endfor %}
            </div>
          </div>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section id="valoraciones">
    <div class="container">
      <div class="test-header reveal">
        <div class="section-label">Valoraciones</div>
        <h2 class="section-h2">Lo que dicen<br>los clientes.</h2>
      </div>
    </div>
    <div class="test-track">
      <div class="test-inner">
        {%- set resenas = [] -%}
        {%- for key, p in proyectos -%}
          {%- if p.resena_texto -%}
            {%- set resenas = (resenas.push(p), resenas) -%}
          {%- endif -%}
        {%- endfor -%}
