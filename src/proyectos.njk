<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=IBM+Plex+Mono:wght@300;400&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;overflow-x:hidden}
:root{
  --white:#FFFFFF;--black:#0D0D0D;
  --gray-50:#F7F7F5;--gray-100:#F0F0EE;--gray-200:#E4E4E2;
  --gray-400:#ABABAB;--gray-600:#6B6B6B;
  --accent:#469A96;--accent-light:#E8F4F3;--accent-dark:#2D706D;
  --font-main:'IBM Plex Sans',sans-serif;--font-mono:'IBM Plex Mono',monospace;
  --nav-h:64px;--max-w:1140px;--px:clamp(20px,5vw,60px);
  --radius:10px;--radius-lg:16px;
}
body{font-family:var(--font-main);background:var(--white);color:var(--black);font-size:16px;line-height:1.6;overflow-x:hidden;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%;height:auto}
a{text-decoration:none;color:inherit}
.container{max-width:var(--max-w);margin:0 auto;padding:0 var(--px)}
.section-label{font-family:var(--font-mono);font-size:11px;color:var(--accent);letter-spacing:.14em;text-transform:uppercase;display:flex;align-items:center;gap:10px;margin-bottom:20px}
.section-label::before{content:'';width:24px;height:1px;background:var(--accent);flex-shrink:0}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .65s ease,transform .65s ease}
.reveal.visible{opacity:1;transform:translateY(0)}

/* NAV */
#nav{position:fixed;top:0;left:0;right:0;height:var(--nav-h);background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--gray-200);z-index:200;transition:box-shadow .3s}
#nav.scrolled{box-shadow:0 1px 20px rgba(0,0,0,.06)}
.nav-inner{height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;gap:24px}
.nav-logo{display:flex;align-items:center;gap:9px;flex-shrink:0}
.nav-links{display:flex;align-items:center;gap:32px;list-style:none}
.nav-links a{font-size:13.5px;color:var(--gray-600);font-weight:400;transition:color .2s;white-space:nowrap}
.nav-links a:hover{color:var(--black)}
.nav-cta{font-size:13px;font-weight:500;color:var(--accent)!important;border:1px solid var(--accent);padding:8px 20px;border-radius:5px;transition:all .2s!important;white-space:nowrap;flex-shrink:0}
.nav-cta:hover{background:var(--accent)!important;color:var(--white)!important}
.nav-toggle{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;background:none;border:none}
.nav-toggle span{display:block;width:22px;height:1.5px;background:var(--black);border-radius:2px;transition:all .3s}
.nav-mobile{display:none;flex-direction:column;position:fixed;top:var(--nav-h);left:0;right:0;background:var(--white);border-bottom:1px solid var(--gray-200);padding:20px var(--px) 28px;gap:20px;z-index:199;transform:translateY(-10px);opacity:0;pointer-events:none;transition:all .3s}
.nav-mobile.open{display:flex;transform:translateY(0);opacity:1;pointer-events:all}
.nav-mobile a{font-size:16px;color:var(--gray-600);padding:4px 0;border-bottom:1px solid var(--gray-100)}
.nav-mobile .nav-cta-mobile{font-size:15px;font-weight:500;color:var(--white)!important;background:var(--accent);text-align:center;padding:12px 20px;border-radius:6px;margin-top:4px;border:none}

/* PAGE HEADER */
#page-header{padding-top:calc(var(--nav-h) + clamp(48px,8vw,80px));padding-bottom:clamp(32px,5vw,56px)}
.page-h1{font-size:clamp(30px,5vw,52px);font-weight:600;line-height:1.1;letter-spacing:-.03em;margin-bottom:12px}
.page-sub{font-size:15px;color:var(--gray-600);font-weight:300;max-width:480px;line-height:1.7;margin-bottom:32px}

/* FILTER BAR */
.filter-bar{display:flex;gap:8px;flex-wrap:wrap}
.filter-btn{font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:7px 16px;border-radius:5px;border:1px solid var(--gray-200);background:var(--white);color:var(--gray-600);cursor:pointer;transition:all .2s;white-space:nowrap}
.filter-btn:hover{border-color:var(--accent);color:var(--accent)}
.filter-btn.active{background:var(--accent);border-color:var(--accent);color:var(--white)}

/* PROJECTS */
#proyectos-section{padding:clamp(40px,7vw,80px) 0 clamp(64px,10vw,120px)}
.section-h2{font-size:clamp(26px,4vw,40px);font-weight:600;line-height:1.15;letter-spacing:-.025em;margin-bottom:14px}
.projects-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.project-card{background:var(--white);border:1px solid var(--gray-200);border-radius:var(--radius-lg);overflow:hidden;cursor:pointer;transition:border-color .25s,transform .25s,box-shadow .25s;display:flex;flex-direction:column;position:relative}
.project-card:hover{border-color:var(--accent);transform:translateY(-4px);box-shadow:0 12px 40px rgba(70,154,150,.1)}
.card-img{aspect-ratio:16/10;background:var(--gray-100);position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
.card-img img.mockup-img{width:100%;height:100%;object-fit:cover}
.card-img-placeholder{width:88%;height:82%;background:var(--white);border-radius:6px;border:1px solid var(--gray-200);padding:10px;display:flex;flex-direction:column;gap:6px}
.card-client-logo{position:absolute;top:12px;left:12px;height:28px;width:auto;max-width:100px;object-fit:contain;border-radius:4px;z-index:2;background:rgba(255,255,255,.9);padding:3px 6px;box-shadow:0 1px 4px rgba(0,0,0,.08)}
.ci-header{display:flex;justify-content:space-between;align-items:center}
.ci-title{font-family:var(--font-mono);font-size:7px;color:var(--black)}
.ci-badge{font-family:var(--font-mono);font-size:6px;color:var(--gray-600);background:var(--gray-100);padding:2px 5px;border-radius:3px}
.ci-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}
.ci-kpi{background:var(--gray-50);border-radius:3px;padding:5px;border:.5px solid var(--gray-200)}
.ci-klbl{font-family:var(--font-mono);font-size:5.5px;color:var(--gray-600);margin-bottom:2px}
.ci-kval{font-family:var(--font-mono);font-size:9px;color:var(--black)}
.ci-bars{display:flex;align-items:flex-end;gap:3px;height:24px;flex:1}
.ci-bar{flex:1;border-radius:2px 2px 0 0;background:var(--gray-200)}
.card-body{padding:22px 22px 20px;display:flex;flex-direction:column;flex:1}
.card-tag{font-family:var(--font-mono);font-size:10px;color:var(--gray-600);letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px}
.card-title{font-size:18px;font-weight:600;color:var(--black);letter-spacing:-.02em;margin-bottom:8px;line-height:1.3}
.card-desc{font-size:13.5px;color:var(--gray-600);line-height:1.65;font-weight:300;margin-bottom:18px;flex:1}
.card-kpis{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.card-kpi-chip{font-family:var(--font-mono);font-size:10px;color:var(--accent-dark);background:var(--accent-light);padding:4px 10px;border-radius:4px}
.card-link{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:500;color:var(--black);border-top:1px solid var(--gray-100);padding-top:16px;transition:color .2s}
.card-link .arr{color:var(--accent);transition:transform .2s}
.project-card:hover .card-link{color:var(--accent)}
.project-card:hover .card-link .arr{transform:translateX(4px)}
.badge-dest{position:absolute;top:12px;right:12px;font-family:var(--font-mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;background:var(--accent);color:var(--white);padding:3px 10px;border-radius:4px;z-index:3}

/* DETAIL */
#project-detail{display:none;padding-top:calc(var(--nav-h) + 48px);padding-bottom:80px;min-height:100vh}
#project-detail.active{display:block}
.detail-back{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--gray-600);margin-bottom:40px;cursor:pointer;transition:color .2s;border:none;background:none;font-family:var(--font-main)}
.detail-back:hover{color:var(--black)}
.detail-header{max-width:680px;margin-bottom:48px}
.detail-logo{height:48px;width:auto;max-width:180px;object-fit:contain;margin-bottom:20px;border-radius:6px}
.detail-tag{font-family:var(--font-mono);font-size:11px;color:var(--gray-600);letter-spacing:.1em;text-transform:uppercase;margin-bottom:12px}
.detail-title{font-size:clamp(28px,4vw,44px);font-weight:600;letter-spacing:-.03em;line-height:1.1;margin-bottom:20px}
.detail-desc{font-size:16px;color:var(--gray-600);line-height:1.75;font-weight:300}
.detail-mockup{width:100%;max-width:800px;border-radius:12px;border:1px solid var(--gray-200);margin-bottom:40px;box-shadow:0 4px 24px rgba(0,0,0,.08)}
.detail-quote{border-left:3px solid var(--accent);padding:20px 24px;background:var(--gray-50);border-radius:0 8px 8px 0;margin:36px 0}
.detail-quote p{font-size:clamp(16px,2.5vw,20px);font-weight:300;font-style:italic;color:var(--black);line-height:1.6}
.detail-quote cite{display:block;font-size:12px;font-family:var(--font-mono);color:var(--gray-600);margin-top:10px;font-style:normal}
.detail-section-title{font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--gray-600);margin-bottom:20px;display:flex;align-items:center;gap:12px}
.detail-section-title::after{content:'';flex:1;height:1px;background:var(--gray-200)}
.detail-problem{font-size:15px;color:var(--black);line-height:1.8;max-width:640px;margin-bottom:40px;font-weight:300}
.features-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;margin-bottom:40px}
.feature-chip{display:flex;align-items:center;gap:10px;background:var(--gray-50);border:1px solid var(--gray-200);border-radius:8px;padding:12px 14px;font-size:13.5px;color:var(--black)}
.feature-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0}
.results-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:40px}
.result-card{background:var(--gray-50);border:1px solid var(--gray-200);border-radius:10px;padding:22px 18px;border-top:3px solid var(--accent)}
.result-text{font-size:14px;color:var(--black);line-height:1.6}
.solution-tag{display:inline-flex;align-items:center;gap:8px;background:var(--accent-light);color:var(--accent-dark);font-family:var(--font-mono);font-size:11px;padding:8px 16px;border-radius:6px}

/* FAB */
.fab-wa{position:fixed;bottom:28px;right:28px;width:52px;height:52px;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(37,211,102,.4);z-index:190;transition:transform .2s,box-shadow .2s}
.fab-wa:hover{transform:scale(1.1);box-shadow:0 8px 30px rgba(37,211,102,.5)}
.fab-wa svg{width:26px;height:26px;fill:var(--white)}

/* FOOTER */
footer{padding:32px var(--px);border-top:1px solid var(--gray-200);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px}
.footer-text{font-family:var(--font-mono);font-size:11px;color:var(--gray-400);letter-spacing:.06em}

/* RESPONSIVE */
@media(max-width:900px){
  .nav-links{display:none}.nav-toggle{display:flex}.nav-cta{display:none}
  .projects-grid{grid-template-columns:repeat(2,1fr)}
  .results-grid{grid-template-columns:1fr}
  .features-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:600px){
  :root{--px:18px}
  .projects-grid{grid-template-columns:1fr}
  .features-grid{grid-template-columns:1fr}
  footer{flex-direction:column;align-items:flex-start}
}
</style>
<script defer src="/_vercel/insights/script.js"></script>
</head>
<body>

<nav id="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <img src="/images/decidata_negro_png.png" alt="deciDATA" style="height:32px;width:auto;display:block;">
    </a>
    <ul class="nav-links">
      <li><a href="/">← Inicio</a></li>
      <li><a href="/#acerca">Sobre mí</a></li>
      <li><a href="/#contacto">Contacto</a></li>
      <li><a href="https://wa.me/{{ general.whatsapp }}" target="_blank" class="nav-cta">Hablemos →</a></li>
    </ul>
    <button class="nav-toggle" id="nav-toggle" aria-label="Menú">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="nav-mobile" id="nav-mobile">
  <a href="/" onclick="closeMenu()">← Inicio</a>
  <a href="/#acerca" onclick="closeMenu()">Sobre mí</a>
  <a href="/#contacto" onclick="closeMenu()">Contacto</a>
  <a href="https://wa.me/{{ general.whatsapp }}" target="_blank" class="nav-cta-mobile">Hablemos por WhatsApp →</a>
</div>

<div id="main-content">

  <section id="page-header">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Portfolio</div>
        <h1 class="page-h1">Proyectos.</h1>
        <p class="page-sub">Sistemas reales para negocios reales. Cada uno parte de un problema concreto, sin templates genéricos.</p>
      </div>
      <div class="filter-bar" id="filter-bar">
        <button class="filter-btn active" data-filter="all">Todos</button>
      </div>
    </div>
  </section>

  <section id="proyectos-section">
    <div class="container">
      <div class="projects-grid" id="projects-grid">
        {%- for key, p in proyectos -%}
        <div class="project-card reveal" data-key="{{ key }}" data-tag="{{ p.tag }}" onclick="openProject('{{ key }}')">
          {%- if p.destacado %}<div class="badge-dest">Destacado</div>{%- endif %}
          <div class="card-img">
            {%- if p.mockup %}
            <img src="{{ p.mockup }}" alt="Sistema de gestión {{ p.titulo }} — deciDATA" class="mockup-img">
            {%- else %}
            <div class="card-img-placeholder">
              <div class="ci-header">
                {%- if p.logo %}<img src="{{ p.logo }}" alt="{{ p.titulo }}" style="height:20px;width:auto;object-fit:contain;">{%- else %}<span class="ci-title">{{ p.titulo }}</span>{%- endif %}
                <span class="ci-badge">Sistema</span>
              </div>
              <div class="ci-kpis">
                {%- for chip in p.chips | slice(3) %}<div class="ci-kpi"><div class="ci-klbl">{{ chip }}</div><div class="ci-kval" style="color:var(--accent)">✓</div></div>{%- endfor %}
              </div>
              <div class="ci-bars">
                <div class="ci-bar" style="height:40%"></div><div class="ci-bar" style="height:55%"></div><div class="ci-bar" style="height:48%"></div><div class="ci-bar" style="height:62%"></div><div class="ci-bar" style="height:58%"></div><div class="ci-bar" style="height:85%;background:var(--accent)"></div>
              </div>
            </div>
            {%- endif %}
            {%- if p.logo and not p.mockup %}<img src="{{ p.logo }}" alt="{{ p.titulo }}" class="card-client-logo">{%- endif %}
          </div>
          <div class="card-body">
            <div class="card-tag">{{ p.tag }}</div>
            <div class="card-title">{{ p.titulo }}</div>
            <div class="card-desc">{{ p.descripcion }}</div>
            <div class="card-kpis">
              {%- for chip in p.chips %}<span class="card-kpi-chip">{{ chip }}</span>{%- endfor %}
            </div>
            <div class="card-link">Ver proyecto <span class="arr">→</span></div>
          </div>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

</div>

<div id="project-detail">
  <div class="container">
    <button class="detail-back" onclick="showGrid()">← Volver a proyectos</button>
    <div id="detail-content"></div>
  </div>
</div>

<a href="https://wa.me/{{ general.whatsapp }}" target="_blank" class="fab-wa" title="Escribir por WhatsApp">
  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
</a>

<footer>
  <div class="nav-logo">
    <img src="/images/decidata_negro_png.png" alt="deciDATA" style="height:24px;width:auto;display:block;">
  </div>
  <span class="footer-text">WhatsApp: {{ general.whatsapp_display }}</span>
  <span class="footer-text">© 2026 deciDATA</span>
</footer>

<script>
const PROYECTOS = {{ proyectos | dump | safe }};

document.addEventListener('DOMContentLoaded', () => {
  const grid = document.getElementById('projects-grid');
  const cards = [...grid.querySelectorAll('.project-card')];
  cards.sort((a, b) => {
    const pa = PROYECTOS[a.dataset.key], pb = PROYECTOS[b.dataset.key];
    return ((pb.destacado ? 1 : 0) - (pa.destacado ? 1 : 0)) || ((pa.orden || 99) - (pb.orden || 99));
  });
  cards.forEach(c => grid.appendChild(c));

  const filterBar = document.getElementById('filter-bar');
  const tipos = new Set();
  Object.values(PROYECTOS).forEach(p => tipos.add(p.tag.split(' · ')[0].trim()));
  tipos.forEach(tipo => {
    const btn = document.createElement('button');
    btn.className = 'filter-btn';
    btn.dataset.filter = tipo;
    btn.textContent = tipo;
    filterBar.appendChild(btn);
  });

  filterBar.addEventListener('click', e => {
    const btn = e.target.closest('.filter-btn');
    if (!btn) return;
    filterBar.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const f = btn.dataset.filter;
    grid.querySelectorAll('.project-card').forEach(card => {
      card.style.display = (f === 'all' || card.dataset.tag.startsWith(f)) ? '' : 'none';
    });
  });
});

function openProject(key) {
  const p = PROYECTOS[key];
  if (!p) return;
  const logoHTML = p.logo ? `<img src="${p.logo}" alt="Logo ${p.titulo}" class="detail-logo">` : '';
  const mockupHTML = p.mockup ? `<img src="${p.mockup}" alt="Sistema de gestión ${p.titulo} — deciDATA" class="detail-mockup">` : '';
  const featuresHTML = (p.funcionalidades || []).map(f => `<div class="feature-chip"><div class="feature-dot"></div>${f}</div>`).join('');
  const resultsHTML = (p.resultados || []).map(r => `<div class="result-card"><div class="result-text">${r}</div></div>`).join('');
  document.getElementById('detail-content').innerHTML = `
    <div class="detail-header">
      ${logoHTML}
      <div class="detail-tag">${p.tag}</div>
      <h1 class="detail-title">${p.titulo}</h1>
      <p class="detail-desc">${p.descripcion}</p>
    </div>
    ${mockupHTML}
    <div class="detail-quote"><p>"${p.quote}"</p><cite>— ${p.quoteAutor}</cite></div>
    <div class="detail-section-title">El problema</div>
    <p class="detail-problem">${p.problema}</p>
    <div class="detail-section-title">Funcionalidades</div>
    <div class="features-grid">${featuresHTML}</div>
    <div class="detail-section-title">Resultados</div>
    <div class="results-grid">${resultsHTML}</div>
    <div class="detail-section-title">Solución</div>
    <div class="solution-tag">→ ${p.solucion}</div>
  `;
  document.getElementById('main-content').style.display = 'none';
  document.getElementById('project-detail').classList.add('active');
  window.scrollTo({top: 0, behavior: 'smooth'});
}

function showGrid() {
  document.getElementById('project-detail').classList.remove('active');
  document.getElementById('main-content').style.display = '';
  window.scrollTo({top: 0, behavior: 'smooth'});
}

window.addEventListener('scroll', () => {
  document.getElementById('nav').classList.toggle('scrolled', window.scrollY > 20);
});

const toggle = document.getElementById('nav-toggle');
const mobileNav = document.getElementById('nav-mobile');
toggle.addEventListener('click', () => mobileNav.classList.toggle('open'));
function closeMenu() { mobileNav.classList.remove('open'); }

const obs = new IntersectionObserver(entries => {
  entries.forEach((e, i) => { if (e.isIntersecting) { setTimeout(() => e.target.classList.add('visible'), i * 60); obs.unobserve(e.target); } });
}, {threshold: .08});
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
</script>
</body>
</html>
